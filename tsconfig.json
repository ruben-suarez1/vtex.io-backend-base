{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@node/*": ["node/*"],
      "@graphql/*": ["graphql/*"]
    }
  },
  "include": ["node/**/*.ts", "react/**/*.ts", "react/**/*.tsx"]
}